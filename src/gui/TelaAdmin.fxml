<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="980.0" style="-fx-background-color: #f4f5f7;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gui.TelaAdminController">

    <!-- CABEÇALHO SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #ff4501; -fx-padding: 18 25 18 25;">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Painel do Administrador - ImportFX" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="Gestão geral de pedidos, relatórios, clientes e fornecedores" textFill="#ffe6dc">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="PERFIL: ADMIN" textFill="WHITE"
                       style="-fx-background-color: rgba(0,0,0,0.25); -fx-padding: 6 14 6 14; -fx-background-radius: 6;">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleSair" text="Sair / Voltar"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 15 10 15; -fx-cursor: hand;" />
            </children>
        </HBox>
    </top>

    <!-- CORPO PRINCIPAL -->
    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets bottom="18.0" left="22.0" right="22.0" top="18.0" />
            </padding>
            <children>
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                        <!-- ABA 1: PEDIDOS, STATUS E RELATÓRIO TOTAL -->
                        <Tab text="Pedidos, Status e Relatório Total">
                            <content>
                                <VBox spacing="14.0" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #dddddd;">
                                    <children>
                                        <!-- Barra de Resumo e Ação de Relatório -->
                                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                                              style="-fx-background-color: #fff8f5; -fx-padding: 12; -fx-border-color: #ffd5c4; -fx-border-radius: 6; -fx-background-radius: 6;">
                                            <children>
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="Total de Pedidos:" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                        <Label fx:id="lblTotalPedidos" text="0">
                                                            <font>
                                                                <Font name="System Bold" size="16.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                                <Region prefWidth="20.0" />
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="Volume Total (Faturas):" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                        <Label fx:id="lblVolumeTotal" text="R$ 0,00" textFill="#ff4501">
                                                            <font>
                                                                <Font name="System Bold" size="16.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                                <Region prefWidth="20.0" />
                                                <VBox spacing="2.0">
                                                    <children>
                                                        <Label text="Total Impostos:" style="-fx-text-fill: #666666; -fx-font-size: 11px;" />
                                                        <Label fx:id="lblTotalImpostos" text="R$ 0,00">
                                                            <font>
                                                                <Font name="System Bold" size="16.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#handleAbrirRelatorios"
                                                        text="Abrir Relatório Completo de Pedidos"
                                                        style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10 16 10 16; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>

                                        <!-- Controles para Alterar Status do Pedido Selecionado -->
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label text="Alterar Status do Pedido Selecionado:">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="cbNovoStatusAdmin" prefWidth="200.0" promptText="Selecione o novo status..." />
                                                <Button mnemonicParsing="false" onAction="#handleAtualizarStatusPedido"
                                                        text="Salvar Novo Status"
                                                        style="-fx-background-color: #ff4501; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 7 16 7 16; -fx-cursor: hand;" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#handleAtualizarTudo"
                                                        text="Atualizar Dados"
                                                        style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-background-radius: 5; -fx-padding: 7 14 7 14; -fx-cursor: hand;" />
                                            </children>
                                        </HBox>

                                        <!-- Tabela Geral de Pedidos -->
                                        <TableView fx:id="tablePedidosAdmin" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colPedId" prefWidth="65.0" text="ID" />
                                                <TableColumn fx:id="colPedData" prefWidth="125.0" text="Data" />
                                                <TableColumn fx:id="colPedCliente" prefWidth="175.0" text="Cliente" />
                                                <TableColumn fx:id="colPedFornecedor" prefWidth="165.0" text="Fornecedor" />
                                                <TableColumn fx:id="colPedImpostos" prefWidth="110.0" text="Impostos" />
                                                <TableColumn fx:id="colPedTotal" prefWidth="125.0" text="Total Final" />
                                                <TableColumn fx:id="colPedStatus" prefWidth="145.0" text="Status Atual" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                        <!-- ABA 2: CLIENTES E FORNECEDORES CADASTRADOS -->
                        <Tab text="Clientes e Fornecedores Cadastrados">
                            <content>
                                <HBox spacing="16.0" style="-fx-background-color: white; -fx-padding: 16; -fx-border-color: #dddddd;">
                                    <children>
                                        <!-- Tabela de Clientes -->
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Clientes Cadastrados">
                                                    <font>
                                                        <Font name="System Bold" size="15.0" />
                                                    </font>
                                                </Label>
                                                <TableView fx:id="tableClientesAdmin" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colCliId" prefWidth="65.0" text="ID" />
                                                        <TableColumn fx:id="colCliNome" prefWidth="185.0" text="Nome do Cliente" />
                                                        <TableColumn fx:id="colCliCpf" prefWidth="120.0" text="CPF" />
                                                        <TableColumn fx:id="colCliEndereco" prefWidth="150.0" text="Endereço" />
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>

                                        <!-- Tabela de Fornecedores -->
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Fornecedores Cadastrados">
                                                    <font>
                                                        <Font name="System Bold" size="15.0" />
                                                    </font>
                                                </Label>
                                                <TableView fx:id="tableFornecedoresAdmin" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colFornId" prefWidth="65.0" text="ID" />
                                                        <TableColumn fx:id="colFornNome" prefWidth="180.0" text="Nome do Fornecedor" />
                                                        <TableColumn fx:id="colFornPais" prefWidth="120.0" text="País" />
                                                        <TableColumn fx:id="colFornMoeda" prefWidth="80.0" text="Moeda" />
                                                    </columns>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>

                <Label fx:id="lblMensagemAdmin" text="" />
            </children>
        </VBox>
    </center>
</BorderPane>