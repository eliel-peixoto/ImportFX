<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane stylesheets="@estilo.css" prefHeight="560.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.TelaCambioController">
   <top>
      <VBox styleClass="header-pane" BorderPane.alignment="CENTER">
         <children>
            <Text styleClass="header-title" text="ImportFX - Câmbio" />
            <Text styleClass="header-subtitle" text="Cotação diária (PTAX do Banco Central do Brasil)" />
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="8.0" styleClass="card-pane">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label fx:id="lblAtualizadoEm" styleClass="form-label" text="Aguardando consulta..." HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <Button fx:id="btnAtualizar" onAction="#handleAtualizar" styleClass="btn-primary" text="Atualizar cotações" />
                     </children>
                  </HBox>
                  <Label fx:id="lblAviso" managed="false" visible="false" wrapText="true" style="-fx-text-fill: #b45309;" />
               </children>
            </VBox>

            <VBox styleClass="card-pane" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="tblCotacoes" prefHeight="300.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colMoeda" prefWidth="90.0" text="Moeda" />
                        <TableColumn fx:id="colCompra" prefWidth="140.0" text="Compra" />
                        <TableColumn fx:id="colVenda" prefWidth="140.0" text="Venda" />
                        <TableColumn fx:id="colData" prefWidth="150.0" text="Data da cotação" />
                        <TableColumn fx:id="colSituacao" prefWidth="220.0" text="Situação" />
                     </columns>
                  </TableView>
               </children>
            </VBox>

            <Label style="-fx-text-fill: #6b7280; -fx-font-size: 11px;" wrapText="true"
                   text="Valores em reais por 1 unidade da moeda. O Banco Central divulga a cotação PTAX em dias úteis; em fins de semana e feriados é exibida a do último dia útil. Os pedidos são convertidos pela cotação de venda." />
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="0.0" />
         </padding>
         <children>
            <Button fx:id="btnVoltar" onAction="#handleVoltarMenu" styleClass="btn-secondary" text="Voltar ao Menu" />
         </children>
      </HBox>
   </bottom>
</BorderPane>